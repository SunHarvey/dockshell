          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴完整的 OpenSSH 或 PEM 私钥。保存后由 DockShell 管理文件，仅当前用户可读；口令仍存入钥匙串。"
          }
