      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the host, then sign in with the session’s chosen authentication method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对主机身份后，使用会话所选的认证方式登录。"
          }
        }
      }
    },
    "ssh.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "ssh.disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接"
          }
        }
      }
    },
    "ssh.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已断开"
          }
        }
      }
    },
    "ssh.error.agentempty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local SSH agent has no identities. Add an authorized key to your agent, then reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 SSH agent 中没有密钥。请向 agent 添加已获服务器授权的密钥，再重新连接。"
          }
        }
      }
    },
    "ssh.error.agenttimeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local SSH agent did not respond in time. Check the agent and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 SSH agent 响应超时，请检查 agent 后重试。"
          }
        }
      }
    },
    "ssh.error.agentunavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local SSH agent is unavailable. Start or unlock your agent and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 SSH agent 不可用，请启动或解锁 agent 后重试。"
          }
        }
      }
    },
    "ssh.error.authentication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Check the username, chosen authentication method and server policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证失败，请检查用户名、所选认证方式及服务器策略。"
          }
        }
      }
    },
    "ssh.error.configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection configuration is invalid. Check the host, port and username."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接配置无效，请检查主机、端口和用户名。"
          }
        }
      }
    },
    "ssh.error.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH connection ended unexpectedly. Check the network and server, then connect again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接异常结束，请检查网络与服务器后重新连接。"
          }
        }
      }
    },
    "ssh.error.helper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed SSH helper is unavailable. Rebuild or reinstall DockShell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用已签名的 SSH 辅助程序，请重新构建或安装 DockShell。"
          }
        }
      }
    },
    "ssh.error.hostchanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This host’s public key differs from the saved record. The connection was stopped. Verify the change with the administrator; DockShell will not replace the record automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机公钥与已保存记录不一致，连接已停止。请向管理员核实；DockShell 不会自动替换记录。"
          }
        }
      }
    },
    "ssh.error.hostrejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host trust was not approved. Authentication has not started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未确认信任主机，认证尚未开始。"
          }
        }
      }
    },
    "ssh.error.incorrectpassphrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private-key passphrase is incorrect. Edit a saved passphrase or enter it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥口令不正确，请修改保存的口令或重新输入。"
          }
        }
      }
    },
    "ssh.error.keepalive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server stopped responding to SSH heartbeats. The connection has closed; check the network and reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未响应 SSH 心跳，连接已断开。请检查网络后重新连接。"
          }
        }
      }
    },
    "ssh.error.keycontainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This private-key container or algorithm is unsupported. Use OpenSSH or a supported RSA/EC/PKCS#8 PEM key. Export PuTTY PPK as OpenSSH with PuTTYgen. DSA is not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此私钥容器或算法。请使用 OpenSSH 或受支持的 RSA、EC、PKCS#8 PEM。PuTTY PPK 请用 PuTTYgen 导出为 OpenSSH；DSA 不受支持。"
          }
        }
      }
    },
    "ssh.error.keymalformed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is not a complete supported private key, or it is too large. Choose the original private-key file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件不是完整的受支持私钥，或文件过大。请重新选择原始私钥文件。"
          }
        }
      }
    },
    "ssh.error.keypermissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key must belong to you and grant no permissions to other users or groups. Check its ownership and permissions (for example, chmod 600)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥必须属于当前用户，且不能向组或其他用户开放权限。请检查所有者与权限，例如 chmod 600。"
          }
        }
      }
    },
    "ssh.error.keyrejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private-key authentication failed. The passphrase may be incorrect, the format may be unsupported by system SSH, or the server may not authorize the key. Check the key, username and server policy, then reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥认证失败，可能是口令错误、系统不支持此密钥格式，或服务器未授权此密钥。请核对密钥、用户名及服务器策略后重新连接。"
          }
        }
      }
    },
    "ssh.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network connection is unavailable or interrupted. Check the network and connect again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不可用或连接中断，请检查网络后重新连接。"
          }
        }
      }
    },
    "ssh.error.passphraserequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the private-key passphrase and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入私钥口令后重试。"
          }
        }
      }
    },
    "ssh.error.passphraseunsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System SSH requires a passphrase of 1–1023 UTF-8 bytes without line breaks or NUL characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 SSH 要求口令为 1～1023 个 UTF-8 字节，且不包含换行或 NUL 字符。"
          }
        }
      }
    },
    "ssh.error.passwordrequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a password and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入密码后重试。"
          }
        }
      }
    },
    "ssh.error.passwordunsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System SSH requires a password of 1–1023 UTF-8 bytes without line breaks or NUL characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 SSH 要求密码为 1～1023 个 UTF-8 字节，且不包含换行或 NUL 字符。"
          }
        }
      }
    },
    "ssh.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused the connection. Check its SSH service and port."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝连接，请检查 SSH 服务及端口。"
          }
        }
      }
    },
    "ssh.error.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not obtain a supported host public key. Check the host, port and network. Servers that require obsolete algorithms are not enabled in this milestone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取受支持的主机公钥，请检查主机、端口与网络。当前阶段未启用必须使用旧算法的服务器兼容设置。"
          }
        }
      }
    },
    "ssh.error.sleep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection setup was interrupted by sleep. Reconnect when the Mac is awake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建立连接的过程被系统睡眠中止，请唤醒后重新连接。"
          }
        }
      }
    },
    "ssh.error.terminal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal process could not be started or its IO failed. Try connecting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动终端进程或读写失败，请重新连接。"
          }
        }
      }
    },
    "ssh.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection timed out. Check the address, network and server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时，请检查地址、网络与服务器状态。"
          }
        }
      }
    },
    "ssh.error.trustcorrupt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host trust file is damaged or has an unsupported format. It has been preserved; repair it before connecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机信任文件损坏或格式不受支持，原文件已保留，请修复后再连接。"
          }
        }
      }
    },
    "ssh.error.truststorage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host trust file cannot be read or saved safely. Check its permissions and whether another DockShell instance is using it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全读取或保存主机信任文件，请检查权限及是否有其他 DockShell 实例正在使用。"
          }
        }
      }
    },
    "ssh.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This authentication method is unsupported. Edit the saved session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此认证方式，请编辑会话配置。"
          }
        }
      }
    },
    "ssh.error.wakereconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac woke during connection setup. Reconnect to begin authentication again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 在建立连接期间进入睡眠并已唤醒，请重新连接并认证。"
          }
        }
      }
    },
    "ssh.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败"
          }
        }
      }
    },
    "ssh.fontdeferred": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Font changes take effect on the next connection. Colors and history settings apply now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体与字号将在下次连接时生效；配色与滚屏历史设置即时生效。"
          }
        }
      }
    },
    "ssh.passphrase.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only for this connection. To remember the passphrase in Keychain, edit the saved session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于本次连接。如需将口令保存到 Keychain，请编辑会话。"
          }
        }
      }
    },
    "ssh.passphrase.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the private key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁私钥"
          }
        }
      }
    },
    "ssh.password.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only for this connection. To remember a password in Keychain, edit the saved session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于本次连接。如需将密码保存到 Keychain，请编辑会话。"
          }
        }
      }
    },
    "ssh.password.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入登录密码"
          }
        }
      }
    },
    "ssh.reconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接"
          }
        }
      }
    },
    "ssh.recovery.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac has woken up. The connection is retained; heartbeats will detect an unresponsive server. You can reconnect manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已唤醒，原连接已保留；心跳将检测服务器是否失去响应。也可以手动重新连接。"
          }
        }
      }
    },
    "ssh.terminal.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote terminal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程终端"
          }
        }
      }
    },
    "ssh.trust.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust and connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任并连接"
          }
        }
      }
    },
    "ssh.trust.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This host is not yet trusted by DockShell. Compare these SHA-256 fingerprints with a trusted source before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DockShell 尚未信任此主机。请先通过可信渠道核对此处的 SHA-256 指纹，再继续连接。"
          }
        }
      }
    },
    "ssh.trust.storehelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust saves these public keys in DockShell’s own known_hosts. No password has been sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后将公钥保存到 DockShell 自有的 known_hosts。此时尚未发送密码。"
          }
        }
      }
    },
    "ssh.trust.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify this host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认主机身份"
          }
        }
      }
    },
    "tab.attention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation Required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认"
          }
        }
      }
    },
    "tab.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Tab"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭标签"
          }
        }
      }
    },
    "tab.connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect in New Tab"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签中连接"
          }
        }
      }
    },
    "tab.connecthelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a session, or connect the selected session in a new tab."
          }
        },
