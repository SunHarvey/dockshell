    "demo.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DockShell · Offline terminal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DockShell · 离线终端"
