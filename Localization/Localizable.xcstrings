    "error.group.duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group with that name already exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名分组。"
          }
        }
      }
    },
    "error.group.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected group no longer exists. Choose another group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选分组已不存在，请重新选择。"
          }
        }
      }
    },
    "error.key.required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a private-key file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择私钥文件。"
          }
        }
      }
    },
    "error.key.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key file is unavailable or its reference is outdated. Choose it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥文件不可用或引用已过期，请重新选择。"
          }
        }
      }
    },
    "error.key.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PuTTY PPK is not supported. Export an OpenSSH key with PuTTYgen, then choose it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持 PuTTY PPK 私钥，请使用 PuTTYgen 导出 OpenSSH 格式后重新选择。"
          }
        }
      }
    },
    "error.keychain.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain access was denied. Check DockShell access in Keychain Access, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙串访问被拒绝，请在“钥匙串访问”中检查 DockShell 权限后重试。"
          }
        }
      }
    },
    "error.keychain.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain is locked or requires authorization. Unlock it or authorize DockShell in Keychain Access, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙串已锁定或需要授权，请在“钥匙串访问”中解锁或授权 DockShell 后重试。"
          }
        }
      }
    },
    "error.keychain.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain is unavailable. Please retry after checking Keychain access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙串暂不可用，请检查钥匙串访问权限后重试。"
          }
        }
      }
    },
    "error.operation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation couldn’t be completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未能完成"
          }
        }
      }
    },
    "error.sessions.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again. If the problem continues, reopen the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试。如果问题仍然存在，请重新打开应用。"
          }
        }
      }
    },
    "error.sessions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载会话"
          }
        }
      }
    },
    "error.storage.corrupt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session database is damaged or is not a SQLite database. Existing files have been kept; restore a backup before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话数据库损坏或不是 SQLite 数据库。现有文件已保留，请恢复备份后重试。"
          }
        }
      }
    },
    "error.storage.inuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another DockShell instance is using this data. Quit the other instance and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 DockShell 实例正在使用会话数据，请退出另一个实例后重试。"
          }
        }
      }
    },
    "error.storage.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read or save session data. Check available disk space and folder permissions, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取或保存会话数据。请检查可用磁盘空间和目录权限后重试。"
          }
        }
      }
    },
    "error.storage.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This database was created by a newer DockShell version. Open it with that version; existing data has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据库由更新版本的 DockShell 创建，请使用相应版本打开。现有数据已保留。"
          }
        }
      }
    },
    "error.validation.groupname": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a group name without control characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入分组名称，不要包含控制字符。"
          }
        }
      }
    },
    "error.validation.host": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a hostname or IP address without a protocol, path or spaces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入主机名或 IP 地址，不要包含协议、路径或空白。"
          }
        }
      }
    },
    "error.validation.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a session name without control characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入会话名称，不要包含控制字符。"
          }
        }
      }
    },
    "error.validation.port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a port between 1 and 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口必须为 1 至 65535 的整数。"
          }
        }
      }
    },
    "error.validation.username": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
