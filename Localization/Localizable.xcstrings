          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥保留在原位置。支持 OpenSSH 及受支持的 PEM；PuTTY PPK 请先用 PuTTYgen 转换。移动文件后请重新选择。"
          }
        }
      }
    },
