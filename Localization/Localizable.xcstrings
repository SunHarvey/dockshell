    "authentication.agenthelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your local OpenSSH-compatible agent when connecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接时使用本机 OpenSSH 兼容的 agent。"
