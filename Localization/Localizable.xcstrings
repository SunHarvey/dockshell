    "delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm deletion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认删除"
          }
        }
      }
    },
    "delete.groupbody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions in this group will move to Ungrouped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组内会话将移到“未分组”，会话本身会保留。"
          }
        }
      }
    },
    "delete.sessionbody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the session and its saved credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除此会话及其保存的凭据。"
          }
        }
      }
    },
    "demo.colors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
