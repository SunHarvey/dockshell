    "credential.cleanupwarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some unused credentials could not be removed from Keychain. Unlock Keychain and retry; cleanup also runs at the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分不再使用的凭据未能从钥匙串移除。请解锁钥匙串后重试；下次启动时也会继续清理。"
          }
        }
      }
    },
    "credential.emptyhelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to be asked when connecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空将在连接时询问。"
          }
        }
      }
    },
    "credential.hide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏密码"
          }
        }
      }
    },
    "credential.keephelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to keep the saved secret. Turn off saving to remove it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空保留已保存的凭据；取消保存可将其移除。"
          }
        }
      }
    },
    "credential.notsaved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not saved; ask if needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存，需要时询问"
          }
        }
      }
    },
