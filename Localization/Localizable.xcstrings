    "demo.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a local rendering and input sample. Typed text is echoed locally; commands are not executed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是本地显示与输入样例。输入内容只在本机回显，不执行命令。"
          }
        }
      }
    },
    "demo.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "› "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "› "
          }
        }
      }
    },
    "demo.sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "中文输入与输出 · 文档/示例.txt · café é · 🙂 🚀 👨‍💻"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中文输入与输出 · 文档/示例.txt · café é · 🙂 🚀 👨‍💻"
